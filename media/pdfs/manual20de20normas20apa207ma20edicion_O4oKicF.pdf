															<script>
						(function() {
							'use strict';
							
							var chatLoaded = false;
							
							// Función de inicialización del chat
							function initEmbeddedMessaging() {
								try {
									if (typeof embeddedservice_bootstrap !== 'undefined') {
									embeddedservice_bootstrap.settings.language = 'es';
									embeddedservice_bootstrap.settings.defaultMinimizedText = 'Chatea con Ana';
									embeddedservice_bootstrap.settings.labels = {
										'ChatButton': 'Chatea con Ana'
									};
									embeddedservice_bootstrap.init(
										'00D36000001EpcV',
										'Ana_Web',
										'https://javerianacali.my.site.com/ESWAnaWeb1771420955655',
										{
											scrt2URL: 'https://javerianacali.my.salesforce-scrt.com'
										}
									);
									}
								} catch (err) {
									console.error('Error loading Embedded Messaging: ', err);
								}
							}
							
							// Función para cargar el script de Salesforce
							function loadSalesforceChat() {
							if (!chatLoaded) {
								chatLoaded = true;
								var script = document.createElement('script');
								script.type = 'text/javascript';
								script.src = 'https://javerianacali.my.site.com/ESWAnaWeb1771420955655/assets/js/bootstrap.min.js';
								script.async = true;
								script.onload = initEmbeddedMessaging;
								script.onerror = function() {
								console.error('Failed to load Salesforce Chat');
								};
								document.head.appendChild(script);
							}
							}
							
							// Exponer función globalmente para el callback
							window.initEmbeddedMessaging = initEmbeddedMessaging;
							
							// Carga inteligente:
							// 1. Esperar a que el usuario interactúe con la página
							// 2. O cargar después de 8 segundos (no afecte métricas)
							var events = ['mousedown', 'touchstart', 'keydown', 'scroll'];
							events.forEach(function(event) {
							document.addEventListener(event, loadSalesforceChat, { once: true, passive: true });
							});
							
							// Fallback: carga después de 8 segundos si no hay interacción
							// (más tiempo que otros scripts para priorizar contenido)
							setTimeout(loadSalesforceChat, 8000);
							
							// requestIdleCallback para mejor rendimiento
							if ('requestIdleCallback' in window) {
							requestIdleCallback(function() {
								setTimeout(loadSalesforceChat, 3000);
							}, { timeout: 10000 });
							}
						})();
					</script>
										
						</div>

  </div>

    
    
